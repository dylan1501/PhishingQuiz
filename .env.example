# Copy file này thành .env khi chạy local và thay toàn bộ giá trị mẫu bằng thông tin thật.
# Không cấu hình y nguyên các giá trị USER/PASSWORD/HOST trên Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/phishing_quiz?schema=public"
ADMIN_SESSION_SECRET="change-this-secret-before-production"
SKIP_DB_MIGRATE=false

# Dev only:
# Set DISABLE_DEV_API_FALLBACK=true if you want local Vite API to fail fast when PostgreSQL is not reachable.
DISABLE_DEV_API_FALLBACK=false
